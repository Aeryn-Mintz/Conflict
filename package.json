{
  "name": "conflict",
  "version": "1.18.1",
  "description": "Secure P2P Comms, VTT & Virtual LAN",
  "main": "js/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.3.3",
    "electron-updater": "^6.1.7",
    "mqtt": "^5.3.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aerynmintz.conflict",
    "productName": "Conflict",
    "asarUnpack": [
      "node_modules/@sapphi-red/web-noise-suppressor/**/*",
      "bin/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "conflict-logo.png",
      "requestedExecutionLevel": "requireAdministrator",
      "extraResources": [
        {
          "from": "bin/win/",
          "to": "bin/win/",
          "filter": ["**/*"]
        }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "extraResources": [
        {
          "from": "bin/linux/",
          "to": "bin/linux/",
          "filter": ["**/*"]
        }
      ]
    }
  }
}