{
  "name": "conflict",
  "version": "1.5.2",
  "description": "Secure P2P Comms & Media",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "localtunnel": "^2.0.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.conflict.app",
    "productName": "Conflict",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "conflict-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
